#!/usr/bin/env php
<?php

/*
 * This file is the CLI entry point for the CodeIgniter framework.
 *
 * Restored - this distribution shipped without it. Layout matches this
 * project's root-level index.php (front controller at the project root,
 * not under public/), so FCPATH points at __DIR__ directly rather than
 * __DIR__/public as CI4's own template does.
 */

define('FCPATH', __DIR__ . DIRECTORY_SEPARATOR);

if (getcwd() . DIRECTORY_SEPARATOR !== FCPATH) {
    chdir(FCPATH);
}

require FCPATH . 'app/Config/Paths.php';

$paths = new Config\Paths();

require $paths->systemDirectory . '/Boot.php';

exit(CodeIgniter\Boot::bootSpark($paths));

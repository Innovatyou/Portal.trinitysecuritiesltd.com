Options -Indexes

# Deny direct access to dotfiles (.env, .git, this .htaccess itself, etc.)
# and data-dump extensions that have no business being web-served. Added
# after .env was found directly downloadable in production: this app has
# no separate public/ webroot, so app/, system/, writable/, .env etc. all
# sit in the same docroot as index.php with nothing else blocking them.
<FilesMatch "(^\.|\.(sql|sqlite|bak|log)$)">
    Require all denied
</FilesMatch>

RewriteEngine On

# Deny direct access to internal application/framework directories - only
# index.php should ever be reached directly; everything else must be
# routed through the front controller (or not served at all).
RewriteCond %{REQUEST_URI} ^/(app|system|writable|vendor|install|updates|tests)(/|$) [NC]
RewriteRule ^ - [F,L]

SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond $1 !^(index\.php|resources|robots\.txt)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?/$1 [L,QSA]
AddDefaultCharset utf-8
